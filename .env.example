# YaQueVas — Variables de entorno
# Copia este archivo como .env y rellena los valores reales antes de desplegar en producción.
# NUNCA subas el archivo .env real a un repositorio ni lo compartas.
# En esta versión de demostración el servidor funciona sin ningún valor real relleno
# (usa valores por defecto y simula los proveedores externos).

# --- Servidor ---
PORT=3000
NODE_ENV=production
SESSION_SECRET=cambia_esto_por_una_cadena_aleatoria_larga_y_secreta

# --- Base de datos ---
# En esta versión de demostración se usa SQLite embebido (backend/data/yaquevas.db) vía node:sqlite.
# Para producción se recomienda migrar a Postgres gestionado.
DATABASE_URL=

# --- Pagos: Stripe Checkout (cobro al remitente) ---
# Sin estas dos variables, el cobro sigue funcionando en modo simulado (como hasta ahora).
# Cómo obtenerlas gratis, sin coste ni tarjeta de crédito (modo test de Stripe):
#   1. Crea una cuenta gratuita en https://dashboard.stripe.com/register (tú, no la IA — requiere
#      tus propios datos; no compartas nunca esta clave).
#   2. Con el interruptor "Modo de prueba" activado, copia la clave secreta de prueba
#      (empieza por sk_test_...) en STRIPE_SECRET_KEY.
#   3. Para probar webhooks en local: instala Stripe CLI y ejecuta
#      `stripe listen --forward-to localhost:3000/api/webhooks/stripe` — te dará el
#      STRIPE_WEBHOOK_SECRET (empieza por whsec_...) para pegar aquí.
# El modo de prueba no cobra dinero real ni tiene coste, sin límite de tiempo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Verificación de identidad: Stripe Identity ---
# Mismo patrón: sin STRIPE_SECRET_KEY no hay verificación real (queda simulada). Con la cuenta
# de arriba, Stripe Identity en modo de prueba tampoco tiene coste. El webhook de verificación
# puede compartir el mismo STRIPE_WEBHOOK_SECRET si registras ambos eventos en el mismo endpoint
# de Stripe CLI/Dashboard (checkout.session.completed e identity.verification_session.verified).

# --- Email transaccional: Resend (https://resend.com) ---
# Sin estas dos variables, el email sigue "enviándose" en modo simulado (se registra en los
# logs del servidor, nunca falla el registro de usuario por esto). Ver docs/EMAIL_SETUP.md.
# Cómo obtenerlas gratis, sin coste ni tarjeta (100 emails/día, 3.000/mes gratis en 2026):
#   1. Crea una cuenta gratuita en https://resend.com/signup (tú, no la IA — requiere tus
#      propios datos; no compartas nunca esta clave).
#   2. En el dashboard, "API Keys" → "Create API Key", cópiala en EMAIL_API_KEY (empieza por re_).
#   3. Verifica un dominio propio en "Domains" para poder poner tu email real en EMAIL_FROM
#      (p.ej. notificaciones@yaquevas.es); sin dominio verificado, Resend deja probar con su
#      remitente de pruebas onboarding@resend.dev, solo para desarrollo.
EMAIL_API_KEY=
EMAIL_FROM=notificaciones@yaquevas.example

# --- SMS / verificación telefónica (pendiente de conectar) ---
SMS_PROVIDER=
SMS_API_KEY=

# --- WhatsApp Business / API oficial (pendiente de conectar) ---
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Notificaciones push (pendiente de conectar) ---
FIREBASE_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# --- Mapas (pendiente de conectar) ---
MAPS_PROVIDER=
MAPS_API_KEY=

# --- Almacenamiento en la nube para fotografías de envíos (pendiente de conectar) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- URLs públicas ---
PUBLIC_APP_URL=https://app.yaquevas.example
PUBLIC_API_URL=https://api.yaquevas.example
